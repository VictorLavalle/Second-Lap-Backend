# Copy to .env and set your local dev values, then run the app (IntelliJ/Maven)
# or docker compose up --build. The .env file is gitignored; never commit real
# credentials (public repo). application.yml has NO defaults: every variable
# below is required so the same contract maps cleanly onto a secrets manager.

# Database connection (JDBC URL; credentials are NOT embedded in the URL)
SECONDLAP_DB_URL=jdbc:postgresql://localhost:5432/secondlap
SECONDLAP_DB_USERNAME=secondlap
SECONDLAP_DB_PASSWORD=changeme

# Admin panel (HTTP Basic)
SECONDLAP_ADMIN_USERNAME=admin
SECONDLAP_ADMIN_PASSWORD=changeme

# HTTP server
SERVER_PORT=8080

# Frontend origin allowed by CORS
SECONDLAP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local image storage
SECONDLAP_UPLOADS_DIR=./uploads
SECONDLAP_UPLOADS_URL_PREFIX=/uploads
SECONDLAP_UPLOADS_MAX_BYTES=5242880

# Request size limits
SECONDLAP_MAX_FILE_SIZE=5MB
SECONDLAP_MAX_REQUEST_SIZE=15MB
SECONDLAP_MAX_FORM_POST=2MB
SECONDLAP_MAX_SWALLOW=2MB

# Store WhatsApp (52 + 10 digits) and per-order item cap
SECONDLAP_STORE_WHATSAPP=529996384026
SECONDLAP_ORDER_MAX_ITEMS=20

# Rate limiting (capacity = requests per window; window in seconds)
SECONDLAP_RL_READS_CAPACITY=120
SECONDLAP_RL_READS_WINDOW=60
SECONDLAP_RL_ORDERS_CAPACITY=5
SECONDLAP_RL_ORDERS_WINDOW=60
SECONDLAP_RL_ORDERS_WA_CAPACITY=3
SECONDLAP_RL_ORDERS_WA_WINDOW=60
SECONDLAP_RL_ADMIN_CAPACITY=10
SECONDLAP_RL_ADMIN_WINDOW=60
